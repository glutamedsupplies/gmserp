rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn()
        && (
          request.auth.token.email == 'kianmaximo17@gmail.com'
          || (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && userDoc().role == 'superAdmin'
          )
        );
    }

    function isAdmin() {
      return isSignedIn() && (userDoc().role == 'admin' || isSuperAdmin());
    }

    function isStaffOfCompanyDoc(companyDocId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/companies/$(companyDocId)/staff/$(request.auth.uid));
    }

    function validTimeEntryCreate() {
      return request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.timeOut == null
        && isStaffOfCompanyDoc(request.resource.data.companyDocumentId);
    }

    function validTimeEntryClockOut() {
      return resource.data.userId == request.auth.uid
        && resource.data.status == 'open'
        && request.resource.data.status == 'closed'
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.companyDocumentId == resource.data.companyDocumentId
        && request.resource.data.timeIn == resource.data.timeIn;
    }

    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && !('password' in request.resource.data);

      allow update: if isSignedIn()
        && !('password' in request.resource.data)
        && (
          isSuperAdmin()
          || (
            request.auth.uid == userId
            && (
              !('role' in request.resource.data)
              || request.resource.data.role == resource.data.role
              || (
                request.auth.token.email == 'kianmaximo17@gmail.com'
                && request.resource.data.role == 'superAdmin'
              )
            )
          )
        );

      allow delete: if isSuperAdmin();
    }

    match /companies/{companyId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSuperAdmin();

      match /staff/{staffId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isAdmin();
      }

      match /tasks/{taskId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSuperAdmin();
      }
    }

    match /timeEntries/{entryId} {
      // Admins/super admins need collection queries by companyId (employee table).
      allow read: if isSignedIn() && (
        isSuperAdmin()
        || isAdmin()
        || resource.data.userId == request.auth.uid
      );

      allow create: if isSignedIn() && (
        isAdmin()
        || validTimeEntryCreate()
      );

      allow update: if isSignedIn() && (
        isAdmin()
        || validTimeEntryClockOut()
      );

      allow delete: if isAdmin();
    }

    match /timeCardSettings/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /leaveRequests/{requestId} {
      allow read: if isSignedIn() && (
        isSuperAdmin()
        || resource.data.userId == request.auth.uid
        || isAdmin()
      );

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update, delete: if isAdmin();
    }

    match /timeCardChangeRequests/{requestId} {
      allow read: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.status == 'pending'
        && request.resource.data.requesterId == request.auth.uid;

      allow update, delete: if isSuperAdmin();
    }
  }
}
