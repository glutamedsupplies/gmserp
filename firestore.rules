rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn()
        && (
          request.auth.token.email == 'kianmaximo17@gmail.com'
          || (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && userDoc().role == 'superAdmin'
          )
        );
    }

    function isAdmin() {
      return isSignedIn() && (userDoc().role == 'admin' || isSuperAdmin());
    }

    function isStaffOfCompanyDoc(companyDocId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/companies/$(companyDocId)/staff/$(request.auth.uid));
    }

    function validTimeEntryCreate() {
      return request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.timeOut == null
        && isStaffOfCompanyDoc(request.resource.data.companyDocumentId);
    }

    function validTimeEntryClockOut() {
      return resource.data.userId == request.auth.uid
        && resource.data.status == 'open'
        && request.resource.data.status == 'closed'
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.companyDocumentId == resource.data.companyDocumentId
        && request.resource.data.timeIn == resource.data.timeIn;
    }

    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && !('password' in request.resource.data);

      allow update: if isSignedIn()
        && !('password' in request.resource.data)
        && (
          isSuperAdmin()
          || (
            request.auth.uid == userId
            && (
              !('role' in request.resource.data)
              || request.resource.data.role == resource.data.role
              || (
                request.auth.token.email == 'kianmaximo17@gmail.com'
                && request.resource.data.role == 'superAdmin'
              )
            )
          )
        );

      allow delete: if isSuperAdmin();
    }

    match /companies/{companyId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSuperAdmin();

      match /staff/{staffId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isAdmin();
      }

      match /tasks/{taskId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSuperAdmin();
      }
    }

    match /timeEntries/{entryId} {
      allow read: if isSignedIn() && (
        isSuperAdmin()
        || isAdmin()
        || resource.data.userId == request.auth.uid
      );

      // Employees cannot write time entries directly (prevents clock bypass).
      // Admin/super admin write after approving clock requests.
      allow create, update, delete: if isAdmin();
    }

    match /timeCardSettings/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /leaveRequests/{requestId} {
      allow read: if isSignedIn() && (
        isSuperAdmin()
        || resource.data.userId == request.auth.uid
        || isAdmin()
      );

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update, delete: if isAdmin();
    }

    match /clockRequests/{requestId} {
      allow read: if isSignedIn() && (
        isSuperAdmin()
        || isAdmin()
        || resource.data.userId == request.auth.uid
      );

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && (
          request.resource.data.type == 'clockIn'
          || request.resource.data.type == 'clockOut'
        );

      allow update, delete: if isAdmin();
    }

    match /timeCardChangeRequests/{requestId} {
      allow read: if isSignedIn() && (
        isSuperAdmin()
        || isAdmin()
        || resource.data.requesterId == request.auth.uid
        || resource.data.employeeId == request.auth.uid
      );

      // Admins may request edits for staff; employees may request edits for themselves.
      allow create: if isSignedIn()
        && request.resource.data.status == 'pending'
        && request.resource.data.requesterId == request.auth.uid
        && (
          isAdmin()
          || request.resource.data.employeeId == request.auth.uid
        );

      // Admins and super admins approve / reject.
      allow update, delete: if isAdmin();
    }

    // OTA release info for in-app "Check for updates" (before Play Store listing).
    match /appConfig/{platform} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    // Daily salary rate changes — employee + company admins + super admins.
    match /salaryRateChanges/{changeId} {
      allow read: if isSignedIn() && (
        isSuperAdmin()
        || isAdmin()
        || request.auth.uid in resource.data.recipientIds
      );

      allow create: if isAdmin()
        && request.resource.data.type == 'salaryRate'
        && request.resource.data.actorId == request.auth.uid;

      allow update, delete: if isSuperAdmin();
    }

    // Super Admin announcements to company members.
    match /announcements/{announcementId} {
      allow read: if isSignedIn() && (
        isSuperAdmin()
        || request.auth.uid in resource.data.recipientIds
      );

      allow create: if isSuperAdmin()
        && request.resource.data.type == 'announcement'
        && request.resource.data.actorId == request.auth.uid;

      allow update, delete: if isSuperAdmin();
    }
  }
}
